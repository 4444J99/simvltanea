+"""Verify actual decoded output, stable holds, moving voices and legacy regression."""
+import copy
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import numpy as np
+from PIL import Image, ImageDraw
+import composition as c
+import make_artifact_001 as make
+ROOT=Path(__file__).resolve().parent
+OUT=make.OUT
+if hasattr(os,'sched_setaffinity'):
+    os.sched_setaffinity(0,set(sorted(os.sched_getaffinity(0))[:4]))
+
+
+def run(cmd):
+    return subprocess.run(cmd,check=True,capture_output=True,timeout=90)
+
+
+def decode(path,width,height):
+    data=run(['ffmpeg','-v','error','-i',str(path),'-vf',f'scale={width}:{height}', '-f','rawvideo','-pix_fmt','rgb24','-']).stdout
+    return np.frombuffer(data,dtype=np.uint8).reshape(-1,height,width,3)
+
+
+def crop(frame,box,inset=2):
+    x,y,w,h=box
+    return frame[y+inset:y+h-inset,x+inset:x+w-inset].astype(float)
+
+
+def diff(a,b):
+    return float(np.abs(a-b).mean())
+
+
+def main():
+    results=[]
+    for count in range(3,7):
+        state=c.load(OUT/f'state-{count}.json')
+        for orientation in c.ORIENTATIONS:
+            name=f'{count}-{orientation}'
+            path=OUT/'renders'/f'{name}.mp4'
+            facts=make.facts(path)
+            video=[s for s in facts['probe']['streams'] if s['codec_type']=='video'][0]
+            dims=(1080,1920) if orientation=='portrait' else (1920,1080)
+            assert (video['width'],video['height'])==dims,name
+            assert video['nb_frames']=='96' and video['r_frame_rate']=='24/1',name
+            assert abs(float(video['duration'])-4)<.001,name
+            assert not any(s['codec_type']=='audio' for s in facts['probe']['streams']),name
+            small=(216,384) if orientation=='portrait' else (384,216)
+            frames=decode(path,*small); assert len(frames)==96,name
+            boxes=c.pixel_boxes(state['layouts'][orientation],*small)
+            hold_box=boxes['loop-1']
+            held_diffs=[diff(crop(frames[18],hold_box),crop(frames[f],hold_box)) for f in range(19,30)]
+            assert max(held_diffs)<2.0,(name,'hold',held_diffs)
+            motion={lid:diff(crop(frames[0],b),crop(frames[12],b)) for lid,b in boxes.items()}
+            assert min(motion.values())>2.0,(name,'moving loops',motion)
+            presence={lid:float(crop(frames[48],b).mean()) for lid,b in boxes.items()}
+            assert min(presence.values())>15.0,(name,'black/missing aperture',presence)
+            min_presence=255.0
+            for f in range(96):
+                frame_boxes=c.pixel_boxes(c.snapshot(state,f)['layouts'][orientation],*small)
+                min_presence=min(min_presence,min(float(crop(frames[f],b).mean()) for b in frame_boxes.values()))
+            assert min_presence>15.0,(name,'unexpected black panel in timeline',min_presence)
+            results.append({'minimum_panel_mean_rgb_all_96_frames':min_presence,'file':name,'decoded_frames':96,'dimensions':dims,'sha256':facts['sha256'],
+                            'held_loop_max_mean_absolute_rgb_difference_18_to_29':max(held_diffs),
+                            'loop_motion_mean_absolute_rgb_difference_0_to_12':motion,
+                            'panel_presence_mean_rgb_frame_48':presence})
+    # Actual still adapter: first aperture is stationary while the two video apertures move.
+    frames=decode(OUT/'renders/still-adapter.mp4',240,426)
+    assert len(frames)==24
+    still_diff=diff(frames[0,2:-2,2:78].astype(float),frames[20,2:-2,2:78].astype(float))
+    moving_diff=diff(frames[0,2:-2,82:158].astype(float),frames[20,2:-2,82:158].astype(float))
+    assert still_diff<2 and moving_diff>2,(still_diff,moving_diff)
+    # Exact old CLI outputs are re-rendered using the refactor on the same toolchain.
+    baseline=json.loads((ROOT/'work/baseline/receipt.json').read_text())
+    if hasattr(os,'sched_setaffinity'):
+        os.sched_setaffinity(0,set(baseline['execution_cpu_affinity']))
+    old=ROOT/'work/baseline'; regression=ROOT/'work/regression'; regression.mkdir(exist_ok=True)
+    legacy=[]
+    for stem in ('clip-none','clip-panel','clip-mix','fixed-none'):
+        output=regression/(stem+'.mp4')
+        cmd=[sys.executable,'render_triptych.py','--manifest',str(old/'manifest.json'), '--output',str(output)]
+        if stem.startswith('clip-'): cmd+=['--audio',stem.split('-')[1]]
+        else: cmd+=['--timing','fixed','--phrase','0.4']
+        result=run(cmd)
+        (regression/(stem+'.log')).write_bytes(result.stdout+b'\nSTDERR\n'+result.stderr)
+        old_hash=baseline['facts'][stem+'.mp4']['sha256']; new_hash=c.hash_file(output)
+        assert old_hash==new_hash,(stem,'legacy byte regression',old_hash,new_hash)
+        legacy.append({'name':stem,'sha256':new_hash,'byte_identical_same_toolchain':True,'argv':cmd})
+    report={'status':'passed','rendered_checks':results,'still_adapter':{'frames':24,'static_diff':still_diff,'moving_diff':moving_diff},
+            'legacy_outputs':legacy,'scope':'Offline render/model checks only; no live-browser or historical reconstruction claim.'}
+    (OUT/'verification.json').write_text(json.dumps(report,indent=2)+'\n')
+    (OUT/'outputs.json').write_text(json.dumps([make.facts(p) for p in sorted((OUT/'renders').glob('*.mp4'))],indent=2)+'\n')
+    # Review sheets contain labels only OUTSIDE the actual exported artwork.
+    for f in (0,24,48,80):
+        sheet=Image.new('RGB',(1260,1220),'#eeeeee'); draw=ImageDraw.Draw(sheet)
+        for row,count in enumerate(range(3,7)):
+            for col,orientation in enumerate(c.ORIENTATIONS):
+                path=OUT/'stills'/f'{count}-{orientation}-f{f:03d}.png'
+                if not path.exists():
+                    run(['ffmpeg','-v','error','-y','-i',str(OUT/'renders'/f'{count}-{orientation}.mp4'),'-vf',f'select=eq(n\\,{f})','-frames:v','1',str(path)])
+                im=Image.open(path); im.thumbnail((550,265))
+                x=col*630+(630-im.width)//2; y=row*305+30
+                sheet.paste(im,(x,y)); draw.text((col*630+25,row*305+10),f'{count} loops | {orientation} | frame {f}',fill='black')
+        sheet.save(OUT/f'inspection-f{f:03d}.jpg',quality=90)
+    print('PASS: eight 96-frame videos; stable holds; every loop moves; still adapter; four byte-identical legacy outputs.')
+
+if __name__=='__main__': main()
