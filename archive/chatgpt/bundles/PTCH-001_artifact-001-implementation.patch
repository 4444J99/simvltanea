+        for f in (0,17,19,43,61,80,95):
+            self.assertEqual(c.snapshot(self.s,f),c.snapshot(other,f))
+
+    def test_source_record_order_not_bank_order_controls_selection(self):
+        other=copy.deepcopy(self.s); other['sources'].reverse(); c.validate(other)
+        self.assertEqual(c.snapshot(self.s,43),c.snapshot(other,43))
+
+    def test_seed_has_stable_golden_vector(self):
+        # Independently specify the algorithm, not Python's hash/random module.
+        payload=b'["sha256-loop-counter/1","seed","voice",0]'
+        expected=['a','b','c'][int.from_bytes(hashlib.sha256(payload).digest(),'big')%3]
+        self.assertEqual(c.choose('seed','voice',0,['a','b','c']),expected)
+
+    def test_ordered_bank_affects_choice(self):
+        self.assertNotEqual(c.choose('s','l',0,['a','b']),c.choose('s','l',0,['b','a']))
+
+    def test_independent_offsets_rates_and_wraps(self):
+        s=copy.deepcopy(self.s); s['events']=[]
