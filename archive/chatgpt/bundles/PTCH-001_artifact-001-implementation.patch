+        with self.assertRaises(c.StateError): c.validate(s)
+
+    def test_versions_are_not_silently_upgraded(self):
+        for key in ('schema','engine','randomness'):
+            s=copy.deepcopy(self.s); s[key]='future'
+            with self.assertRaises(c.StateError): c.validate(s)
+
+    def test_audio_routing_fail_explicitly(self):
+        for key,val in [('audio',{'mode':'mix','generative':None}),('routing',[{'x':1}])]:
+            s=copy.deepcopy(self.s); s[key]=val
+            with self.assertRaisesRegex(c.StateError,'not implemented'): c.validate(s)
+
+    def test_bad_clocks(self):
+        for key,val in [('rate',[0,1]),('rate',[1,0]),('rate',[-1,1]),('offset',[3,1]),('held','false'),('counter',True),('trim',[[2,1],[1,1]])]:
+            s=copy.deepcopy(self.s); s['loops'][0][key]=val
+            with self.assertRaises(c.StateError): c.validate(s)
+
+    def test_geometry_duplicate_drop_overlap_nonfinite(self):
+        for mutation in ('drop','duplicate','overlap','nan','outside'):
+            s=copy.deepcopy(self.s); ps=s['layouts']['portrait']['placements']
+            if mutation=='drop': ps.pop()
+            if mutation=='duplicate': ps[1]['loop']=ps[0]['loop']
+            if mutation=='overlap': ps[1]['rect']=ps[0]['rect'][:]
+            if mutation=='nan': ps[0]['rect'][0]=float('nan')
+            if mutation=='outside': ps[0]['rect'][2]=2
+            with self.assertRaises(c.StateError): c.validate(s)
+
+    def test_missing_orientation(self):
+        del self.s['layouts']['landscape']
+        with self.assertRaises(c.StateError): c.validate(self.s)
+
+    def test_bad_events(self):
+        for event in ({'frame':1,'op':'dance'}, {'frame':96,'op':'reroll','loop':'loop-1'}, {'frame':0,'op':'reroll','loop':'missing'}, {'frame':0,'op':'swap','loops':['loop-1','loop-1']}, {'frame':0,'op':'hold','loop':'loop-1','value':1}):
+            s=copy.deepcopy(self.s); s['events']=[event]
+            with self.assertRaises(c.StateError): c.validate(s)
+
+    def test_unsorted_events_fail(self):
+        self.s['events'].reverse()
+        with self.assertRaises(c.StateError): c.validate(self.s)
+
+    def test_duplicate_media_requires_explicit_reuse(self):
+        s=copy.deepcopy(self.s); s['events']=[]
+        s['loops'][1]['bank']=s['loops'][0]['bank'][:]
+        for l in s['loops'][:2]: l['source']=s['loops'][0]['bank'][0]
+        with self.assertRaises(c.StateError): c.validate(s)
+        s['allow_source_reuse']=True; c.validate(s)
+        self.assertNotEqual(s['loops'][0]['id'],s['loops'][1]['id'])
+
+    def test_trims_fit_all_candidates(self):
+        self.s['sources'][1]['duration']=[1,1]
+        with self.assertRaises(c.StateError): c.validate(self.s)
+
+    def test_viewport_and_resource_limits_fail_without_panel_drops(self):
+        with self.assertRaises(c.StateError): c.pixel_boxes(self.s['layouts']['portrait'],2,2)
+        with self.assertRaises(c.StateError): c.pixel_boxes(self.s['layouts']['portrait'],391,843)
+        self.s['frames']=c.MAX_FRAMES+1
+        with self.assertRaises(c.StateError): c.validate(self.s)
+
+    def test_nearby_mobile_desktop_sizes_every_loop_present(self):
