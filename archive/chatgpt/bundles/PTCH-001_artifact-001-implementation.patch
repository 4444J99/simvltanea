@@ -0,0 +1,197 @@
+#!/usr/bin/env python3
+"""Generate synthetic inputs and eight authored compositions, then render them.
+
+No historical/private media and no network calls. All outputs remain in work/.
+A reconstruction uses saved source bytes/hashes; the source generator is also
+provided, but encoding on another toolchain need not have identical byte hashes.
+"""
+from __future__ import annotations
+import argparse
+import copy
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+import composition as c
+
+ROOT = Path(__file__).resolve().parent
+OUT = ROOT / "work" / "artifact-001"
+# Authored aperture maps, not generated per-count grids. Placement array is z-order.
+DESIGNS = {
+    3: {
+        "portrait": ("three-voices-columns", [[0, 0, 1/3, 1], [1/3, 0, 1/3, 1], [2/3, 0, 1/3, 1]]),
+        "landscape": ("three-voices-suspended", [[.04,.16,.28,.68],[.36,.06,.28,.88],[.68,.22,.28,.62]]),
+    },
+    4: {
+        "portrait": ("four-offset-quadrants", [[.04,.04,.44,.42],[.52,.12,.44,.34],[.04,.52,.38,.44],[.46,.50,.50,.46]]),
+        "landscape": ("four-bookends", [[.04,.07,.28,.86],[.35,.07,.30,.40],[.35,.51,.30,.42],[.68,.18,.28,.65]]),
+    },
+    5: {
+        "portrait": ("five-spine-and-flanks", [[.35,.04,.30,.92],[.04,.10,.27,.35],[.04,.50,.27,.42],[.69,.04,.27,.44],[.69,.54,.27,.42]]),
+        "landscape": ("five-anchor-and-echoes", [[.04,.08,.36,.84],[.44,.06,.24,.41],[.72,.12,.24,.35],[.44,.51,.24,.43],[.72,.53,.24,.41]]),
+    },
+    6: {
+        "portrait": ("six-staggered-pairs", [[.04,.04,.44,.28],[.52,.10,.44,.22],[.04,.36,.34,.28],[.42,.36,.54,.28],[.04,.68,.54,.28],[.62,.68,.34,.23]]),
+        "landscape": ("six-asymmetric-columns", [[.04,.05,.24,.53],[.04,.62,.24,.33],[.32,.12,.36,.36],[.32,.52,.36,.43],[.72,.05,.24,.34],[.72,.43,.24,.46]]),
+    },
+}
+
+
+def run(cmd: list[str], label: str, commands: list[dict]) -> None:
+    started = time.monotonic()
+    result = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True, timeout=240)
+    (OUT / "logs" / f"{label}.log").write_text(result.stdout + "\nSTDERR\n" + result.stderr, encoding="utf-8")
+    commands.append({"argv": cmd, "label": label, "returncode": result.returncode, "elapsed_seconds": round(time.monotonic()-started,3)})
+    (OUT / "commands.json").write_text(json.dumps(commands, indent=2)+"\n")
+    if result.returncode:
+        raise RuntimeError(f"{label} failed: {result.stderr[-3000:]}")
+
+
+def make_state(count: int, sources: list[dict]) -> dict:
+    layouts = {}
+    for orientation, (name, boxes) in DESIGNS[count].items():
+        layouts[orientation] = {"name": name, "placements": [{"loop": f"loop-{i+1}", "rect": rect,
+                                   "fit": "cover", "focal": [.5,.5]} for i, rect in enumerate(boxes)]}
+    state = {"schema": c.SCHEMA, "engine": c.ENGINE, "randomness": c.RANDOMNESS,
+             "id": f"artifact-001-{count}", "seed": "VNT0N1VS-artifact-001", "fps": 24, "frames": 96,
+             "sources": sources, "loops": [], "layouts": layouts, "events": [],
+             "audio": {"mode": "none", "generative": None}, "routing": [], "allow_source_reuse": False,
+             "note": "Synthetic engineering proof; proposed layouts, not historical reconstruction or artist-approved release."}
+    rates = [[1,1],[1,2],[3,2],[1,1],[2,1],[3,4]]
+    for i in range(count):
+        bank = [f"source-{i+1}", f"source-{i+1}-alternate"]
+        state["loops"].append({"id": f"loop-{i+1}", "bank": bank, "source": None, "counter": 0,
+                               "offset": [i, 8], "rate": rates[i], "trim": [[0,1],[2,1]], "held": False})
+    state["events"] = [
+        {"frame": 18, "op": "hold", "loop": "loop-1", "value": True},
+        {"frame": 30, "op": "hold", "loop": "loop-1", "value": False},
+        {"frame": 42, "op": "reroll", "loop": "loop-2"},
+        {"frame": 60, "op": "swap", "loops": ["loop-1", "loop-3"]},
+    ]
+    # A gentle inset tests serialized move in each orientation, without overlap.
+    for orientation in c.ORIENTATIONS:
+        x,y,w,h = layouts[orientation]["placements"][-1]["rect"]
+        state["events"].append({"frame": 72, "op": "move", "loop": f"loop-{count}", "orientation": orientation,
+                                "rect": [x+w*.04, y+h*.04, w*.92, h*.92]})
+    c.validate(state)
+    return state
+
+
+def generate_sources(commands: list[dict]) -> list[dict]:
+    sources = []
+    # Smooth periodic geometry with two distinct variants per loop; 2-second cycles.
+    # 96 source frames permit sub-frame-rate slow playback in the 24fps composition.
+    for i in range(6):
+        for alt in (False, True):
+            sid = f"source-{i+1}" + ("-alternate" if alt else "")
+            path = OUT / "media" / f"{sid}.mp4"
+            hue = i*57 + (23 if alt else 0)
+            phase = i*.55 + (1.2 if alt else 0)
+            # geq runs per-pixel on a compact source, then hue gives each voice identity.
+            expr = (f"nullsrc=s=320x240:r=48:d=2,format=yuv444p,"
+                    f"geq=lum='40+110*(0.5+0.5*sin(2*PI*(X/W*{2+(i%3)}+Y/H*0.45-T/2)+{phase}))':"
+                    f"cb='128+65*sin(2*PI*(Y/H+T/2)+{phase})':"
+                    f"cr='128+65*cos(2*PI*(X/W-T/2)+{phase})',hue=h={hue}")
+            run(["ffmpeg","-hide_banner","-loglevel","error","-y","-f","lavfi","-i",expr,
+                 "-an","-c:v","libx264","-preset","veryfast","-crf","16","-pix_fmt","yuv420p",str(path)],sid,commands)
+            sources.append({"id":sid,"path":f"media/{path.name}","sha256":c.hash_file(path),"kind":"video","duration":[2,1]})
+    # Still fixture is an actual static source frame, not schema-only support.
+    path = OUT / "media" / "still.png"
+    run(["ffmpeg","-hide_banner","-loglevel","error","-y","-i",str(OUT/"media"/"source-1.mp4"),
+         "-frames:v","1",str(path)],"source-still",commands)
+    sources.append({"id":"still","path":"media/still.png","sha256":c.hash_file(path),"kind":"still","duration":[2,1]})
+    return sources
+
+
+def facts(path: Path) -> dict:
+    probe = json.loads(subprocess.check_output(["ffprobe","-v","error","-show_streams","-show_format","-of","json",str(path)],text=True))
+    return {"path":str(path.relative_to(OUT)),"bytes":path.stat().st_size,"sha256":c.hash_file(path),"probe":probe}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--prepare-only", action="store_true")
+    parser.add_argument("--render-only", action="store_true")
+    parser.add_argument("--only", help="One count, e.g. 4, to render a bounded batch")
+    parser.add_argument("--resume", action="store_true", help="Reuse outputs only after expected stream/frame checks")
+    parser.add_argument("--draft", action="store_true", help="540/960 proof; default reference exports are full HD")
+    args = parser.parse_args()
+    if hasattr(os,"sched_setaffinity"):
+        os.sched_setaffinity(0,set(sorted(os.sched_getaffinity(0))[:4]))
+    for folder in ("media","renders","stills","logs"):
+        (OUT/folder).mkdir(parents=True,exist_ok=True)
+    commands = []
+    if args.render_only:
+        sources=json.loads((OUT/"source-manifest.json").read_text())["sources"]
+        if (OUT/"commands.json").exists():
+            commands=json.loads((OUT/"commands.json").read_text())
+    else:
+        sources=generate_sources(commands)
+        (OUT/"source-manifest.json").write_text(json.dumps({"synthetic":True,"sources":sources},indent=2)+"\n")
+        for count in DESIGNS:
+            c.save(make_state(count,sources),OUT/f"state-{count}.json")
+        still=make_state(3,sources)
+        still["id"]="artifact-001-still-adapter"
+        still["loops"][0].update(bank=["still"],source="still")
+        still["events"]=[]
+        still["frames"]=24
+        c.save(still,OUT/"state-still.json")
+    if args.prepare_only:
+        print("Prepared synthetic source banks and paired states.")
+        return
+    receipts_path=OUT/"render-receipts.json"
+    receipts=json.loads(receipts_path.read_text()) if receipts_path.exists() else {}
+    outputs=[]
+    for count in DESIGNS:
+        if args.only and str(count) != args.only:
+            continue
+        for orientation in c.ORIENTATIONS:
+            name=f"{count}-{orientation}"
+            dims = (540,960) if args.draft else (1080,1920)
+            if orientation=="landscape":
+                dims=dims[::-1]
+            path=OUT/"renders"/f"{name}.mp4"
+            recipe={"state_sha256":c.hash_file(OUT/f"state-{count}.json"),
+                    "renderer_sha256":c.hash_file(ROOT/"render_triptych.py"),
+                    "composition_sha256":c.hash_file(ROOT/"composition.py"),
+                    "width":dims[0],"height":dims[1],"preset":"veryfast","crf":20}
+            complete = False
+            if args.resume and path.exists() and receipts.get(name,{}).get("recipe")==recipe:
+                try:
+                    streams = facts(path)["probe"]["streams"]
+                    v = next(s for s in streams if s["codec_type"] == "video")
+                    complete = ((v["width"],v["height"],int(v.get("nb_frames",0))) == (*dims,96)
+                                and c.hash_file(path)==receipts[name]["sha256"])
+                except (subprocess.CalledProcessError,KeyError,ValueError,StopIteration):
+                    pass
+            if not complete:
+                run([sys.executable,"render_triptych.py","--composition",str(OUT/f"state-{count}.json"),
+                     "--orientation",orientation,"--width",str(dims[0]),"--height",str(dims[1]),
+                     "--preset","veryfast","--crf","20","--output",str(path)],name,commands)
+                receipts[name]={"recipe":recipe,"sha256":c.hash_file(path)}
+                receipts_path.write_text(json.dumps(receipts,indent=2)+"\n")
+            temporary=OUT/"stills"/f"{name}-sample-%02d.png"
+            run(["ffmpeg","-hide_banner","-loglevel","error","-y","-i",str(path),"-vf",
+                 "select=eq(n\\,0)+eq(n\\,24)+eq(n\\,48)+eq(n\\,80)","-fps_mode","vfr",str(temporary)],f"{name}-stills",commands)
+            for sample,frame in enumerate((0,24,48,80),start=1):
+                (OUT/"stills"/f"{name}-sample-{sample:02d}.png").replace(OUT/"stills"/f"{name}-f{frame:03d}.png")
+            outputs.append(facts(path))
+            (OUT/"outputs.json").write_text(json.dumps(outputs,indent=2)+"\n")
+            print(f"Rendered {name}",flush=True)
+    path=OUT/"renders"/"still-adapter.mp4"
+    still_recipe={"renderer_sha256":c.hash_file(ROOT/"render_triptych.py"),"composition_sha256":c.hash_file(ROOT/"composition.py"),
+                  "state_sha256":c.hash_file(OUT/"state-still.json")}
+    if not path.exists() or receipts.get("still-adapter",{}).get("recipe")!=still_recipe:
+        run([sys.executable,"render_triptych.py","--composition",str(OUT/"state-still.json"),"--orientation","portrait",
+             "--width","240","--height","426","--preset","ultrafast","--output",str(path)],"still-adapter",commands)
+        receipts["still-adapter"]={"recipe":still_recipe,"sha256":c.hash_file(path)}
+        receipts_path.write_text(json.dumps(receipts,indent=2)+"\n")
+    outputs.append(facts(path))
+    (OUT/"outputs-last-batch.json").write_text(json.dumps(outputs,indent=2)+"\n")
+    print("Artifact family rendered; visual inspection is a separate gate.")
+
+
+if __name__=="__main__":
+    main()
