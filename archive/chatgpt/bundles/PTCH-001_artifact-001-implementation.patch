+            path=Path(d)/'state.json'; path.write_text('{"schema":1,"schema":2}')
+            with self.assertRaisesRegex(c.StateError,'Duplicate'): c.load(path,verify_media=False)
+
+    def test_compiler_uses_existing_segment_and_panel_classes(self):
