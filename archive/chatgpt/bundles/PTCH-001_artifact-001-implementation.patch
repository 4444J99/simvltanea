+"""Baseline receipt runner; does not change the upstream renderer."""
+import hashlib, json, os, subprocess, sys
+from pathlib import Path
+ROOT = Path(__file__).resolve().parent
+os.sched_setaffinity(0, set(sorted(os.sched_getaffinity(0))[:2]))
+OUT = ROOT / 'work' / 'baseline'
+OUT.mkdir(parents=True, exist_ok=True)
+source = (ROOT/'render_triptych.py').read_bytes()
+assert hashlib.sha1(b'blob '+str(len(source)).encode()+b'\0'+source).hexdigest() == '6155fa1b8c9d5284c3deda0eaf56b342e47cf1bc'
+(OUT/'render_triptych.py.original').write_bytes(source)
+commands=[]
+def run(cmd, name):
+    commands.append(cmd)
+    p=subprocess.run(cmd,cwd=ROOT,capture_output=True,text=True,timeout=90)
+    (OUT/(name+'.log')).write_text(p.stdout+'\nSTDERR\n'+p.stderr)
+    if p.returncode: raise RuntimeError(f'{name} failed ({p.returncode}): {p.stderr[-2000:]}')
+    return p
+for i,d in enumerate([0.4,0.6,0.8]):
+    run(['ffmpeg','-hide_banner','-loglevel','error','-y','-f','lavfi','-i',f'testsrc2=size=160x120:rate=10:duration={d}', '-f','lavfi','-i',f'sine=frequency={220*(i+1)}:sample_rate=48000:duration={d}', '-vf',f'hue=h={i*100}','-c:v','libx264','-preset','ultrafast','-pix_fmt','yuv420p','-c:a','aac',str(OUT/f'source-{i}.mp4')],f'generate-{i}')
+manifest={'clips':[f'source-{i}.mp4' for i in range(3)], 'canvas':{'width':240,'height':426,'fps':10},'render':{'crf':20,'preset':'ultrafast'},'work_dir':'.','output_file':'clip-none.mp4'}
+(OUT/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+for mode in ['none','panel','mix']:
+    cmd=[sys.executable,'render_triptych.py','--manifest',str(OUT/'manifest.json'),'--audio',mode,'--output',str(OUT/f'clip-{mode}.mp4')]
+    run(cmd,f'clip-{mode}')
+run([sys.executable,'render_triptych.py','--manifest',str(OUT/'manifest.json'),'--timing','fixed','--phrase','0.4','--output',str(OUT/'fixed-none.mp4')],'fixed-none')
+import render_triptych as r
+from unittest.mock import patch
+with patch.object(sys,'argv',['render_triptych.py','--manifest',str(OUT/'manifest.json')]):
+    settings=r.build_settings(r.parse_args())
+clips=r.load_clips(settings)
+schedule=[{'index':s.index,'start':s.start,'duration':s.duration,'panels':[{'id':p.name,'source':p.source_index,'offset':p.source_offset} for p in s.panels]} for s in r.build_segments(clips,settings)]
+facts={}
+for p in OUT.glob('*.mp4'):
+    probe=run(['ffprobe','-v','error','-show_streams','-show_format','-of','json',str(p)],p.stem+'-probe')
+    facts[p.name]={'sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'bytes':p.stat().st_size,'probe':json.loads(probe.stdout)}
+receipt={'upstream_commit':'48da3da293ecd7604b6c9d3ce19d0bf49a70013d','upstream_renderer_blob':'6155fa1b8c9d5284c3deda0eaf56b342e47cf1bc','retrieval':'connector text materialized locally and Git blob SHA-1 matched exactly','python':sys.version,'ffmpeg':subprocess.check_output(['ffmpeg','-version'],text=True).splitlines()[0],'execution_cpu_affinity':sorted(os.sched_getaffinity(0)),'commands':commands,'schedule':schedule,'facts':facts}
+(OUT/'receipt.json').write_text(json.dumps(receipt,indent=2)+'\n')
+print('Baseline complete: clip none/panel/mix, fixed none; source blob verified.')
+print(json.dumps(schedule,indent=2))
