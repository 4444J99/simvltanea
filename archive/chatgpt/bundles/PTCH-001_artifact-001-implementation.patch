+        self.assertEqual(a['loop-2']['phase'],[5,8])
+        self.assertEqual(a['loop-3']['phase'],[7,4])
+        self.assertEqual(c.snapshot(s,48)['loops']['loop-1']['phase'],[0,1])
+
+    def test_reroll_while_held_is_explicit_change_but_stays_held(self):
+        s=copy.deepcopy(self.s); s['events']=[{'frame':0,'op':'hold','loop':'loop-1','value':True},{'frame':1,'op':'reroll','loop':'loop-1'}]
+        c.validate(s)
+        a,b=c.snapshot(s,0)['loops']['loop-1'],c.snapshot(s,3)['loops']['loop-1']
+        self.assertNotEqual(a['source'],b['source']); self.assertTrue(b['held']); self.assertEqual(b['phase'],[0,1])
+
+    def test_same_frame_array_order_is_preserved(self):
+        s=copy.deepcopy(self.s); s['events']=[{'frame':4,'op':'hold','loop':'loop-1','value':True},{'frame':4,'op':'hold','loop':'loop-1','value':False}]
+        self.assertFalse(c.snapshot(s,4)['loops']['loop-1']['held'])
+        s['events'].reverse(); self.assertTrue(c.snapshot(s,4)['loops']['loop-1']['held'])
+
+    def test_validation_rejects_missing_and_unknown_fields(self):
+        for key in ('seed','schema','loops','layouts','audio'):
+            s=copy.deepcopy(self.s); del s[key]
+            with self.assertRaises(c.StateError): c.validate(s)
