+            state=fixture.make_state(count,fake_sources()); c.validate(state)
+            for layout in state['layouts'].values():
+                names.add(layout['name']); self.assertEqual(len(layout['placements']),count)
+        self.assertEqual(len(names),8)
+
+    def test_serialization_roundtrip_replays_every_frame(self):
+        other=json.loads(c.canonical(self.s)); c.validate(other)
+        for frame in range(self.s['frames']):
+            self.assertEqual(c.snapshot(self.s,frame),c.snapshot(other,frame))
+
+    def test_hold_freezes_only_target(self):
+        a,b=(c.snapshot(self.s,f)['loops'] for f in (18,29))
+        self.assertEqual(a['loop-1']['phase'],b['loop-1']['phase'])
+        self.assertNotEqual(a['loop-2']['phase'],b['loop-2']['phase'])
+
+    def test_release_no_catchup(self):
+        a,b,d=(c.snapshot(self.s,f)['loops']['loop-1'] for f in (18,30,31))
+        self.assertEqual(a['phase'],b['phase'])
+        self.assertEqual(Fraction(*d['phase'])-Fraction(*b['phase']),Fraction(1,24))
+
+    def test_reroll_changes_source_and_counter_only_target(self):
+        a,b=(c.snapshot(self.s,f)['loops'] for f in (41,42))
+        self.assertNotEqual(a['loop-2']['source'],b['loop-2']['source'])
+        self.assertEqual(b['loop-2']['counter'],1)
+        self.assertEqual(b['loop-2']['phase'],[0,1])
+        self.assertEqual(a['loop-1']['counter'],b['loop-1']['counter'])
+        self.assertEqual(a['loop-1']['source'],b['loop-1']['source'])
+
+    def test_swap_sources_not_clocks_banks_or_identity(self):
+        control=copy.deepcopy(self.s); control['events']=[e for e in control['events'] if e['op']!='swap']
+        a,b=c.snapshot(control,60)['loops'],c.snapshot(self.s,60)['loops']
+        self.assertEqual(a['loop-1']['source'],b['loop-3']['source'])
+        self.assertEqual(a['loop-3']['source'],b['loop-1']['source'])
+        for key in ('phase','counter','rate','held'):
+            self.assertEqual(a['loop-1'][key],b['loop-1'][key])
+
+    def test_move_only_presentation(self):
+        control=copy.deepcopy(self.s); control['events']=[e for e in control['events'] if e['op']!='move']
+        a,b=c.snapshot(control,80),c.snapshot(self.s,80)
+        self.assertEqual(a['loops'],b['loops']); self.assertNotEqual(a['layouts'],b['layouts'])
+
+    def test_orientation_roundtrip_does_not_touch_clocks(self):
+        for f in range(96):
+            before=c.canonical(self.s); snap=c.snapshot(self.s,f)
+            for w,h in ((390,844),(1440,900),(390,844)):
+                orientation=c.orientation_for(w,h)
+                c.pixel_boxes(snap['layouts'][orientation],w,h)
+                self.assertEqual(c.snapshot(self.s,f)['loops'],snap['loops'])
+            self.assertEqual(c.canonical(self.s),before)
+
+    def test_loop_evaluation_order_independent(self):
