@@ -0,0 +1,449 @@
+"""Versioned, frame-addressed composition state; no rendering or UI side effects.
+
+Time is an output-frame index. Local phases use exact rational seconds. Events at
+frame f apply before sampling f; a held clock resumes without catching up. Layout
+selection is a projection and never mutates loop state. See COMPOSITION.md.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+import re
+import subprocess
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+SCHEMA = "portvs.composition/1"
+ENGINE = "portvs-segments/1.0.0"
+RANDOMNESS = "sha256-loop-counter/1"
+ORIENTATIONS = ("portrait", "landscape")
+MAX_LOOPS = 16  # validation ceiling, NOT a claim that 16 loops are performance-tested
+MAX_FRAMES = 14400
+ID = re.compile(r"^[A-Za-z0-9_.-]{1,80}$")
+
+
+class StateError(ValueError):
+    """Invalid state or explicitly unsupported capability."""
+
+
+def canonical(state: dict[str, Any]) -> str:
+    return json.dumps(state, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False)
+
+
+def save(state: dict[str, Any], path: Path) -> None:
+    validate(state)
+    path.write_text(json.dumps(state, indent=2, ensure_ascii=False, allow_nan=False) + "\n", encoding="utf-8")
+
+
+def load(path: Path, *, verify_media: bool = True) -> dict[str, Any]:
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise StateError(f"Duplicate JSON key: {key}")
+            result[key] = value
+        return result
+    try:
+        state = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=pairs,
+                           parse_constant=lambda s: (_ for _ in ()).throw(StateError(f"Non-finite JSON: {s}")))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise StateError(f"Cannot read composition: {exc}") from exc
+    validate(state, path.parent if verify_media else None)
+    return state
+
+
+def keys(value: Any, required: set[str], optional: set[str], label: str) -> None:
+    if not isinstance(value, dict):
+        raise StateError(f"{label} must be an object")
+    missing, unknown = required - value.keys(), value.keys() - required - optional
+    if missing or unknown:
+        raise StateError(f"{label}: missing={sorted(missing)}, unsupported={sorted(unknown)}")
+
+
+def integer(value: Any, lo: int, hi: int, label: str) -> int:
+    if type(value) is not int or not lo <= value <= hi:
+        raise StateError(f"{label} must be an integer in [{lo}, {hi}]")
+    return value
+
+
+def number(value: Any, lo: float, hi: float, label: str) -> float:
+    if type(value) not in (float, int) or not math.isfinite(value) or not lo <= value <= hi:
+        raise StateError(f"{label} must be finite in [{lo}, {hi}]")
+    return float(value)
+
+
+def fraction(value: Any, label: str) -> Fraction:
+    if not isinstance(value, list) or len(value) != 2:
+        raise StateError(f"{label} must be [integer numerator, positive denominator]")
+    integer(value[0], 0, 10**9, label)
+    integer(value[1], 1, 10**9, label)
+    return Fraction(*value)
+
+
+def identifier(value: Any, label: str) -> str:
+    if not isinstance(value, str) or not ID.fullmatch(value):
+        raise StateError(f"Invalid {label}: {value!r}")
+    return value
+
+
+def media_path(source: dict[str, Any], root: Path) -> Path:
+    raw = source["path"]
+    if not isinstance(raw, str) or not raw or Path(raw).is_absolute():
+        raise StateError("Source path must be a nonempty relative path")
+    path = (root / raw).resolve()
+    if not path.is_relative_to(root.resolve()):
+        raise StateError("Source path escapes the state directory")
+    return path
+
+
+def hash_file(path: Path) -> str:
+    with path.open("rb") as handle:
+        return hashlib.file_digest(handle, "sha256").hexdigest()
+
+
+def geometry(placement: Any) -> None:
+    keys(placement, {"loop", "rect", "fit", "focal"}, set(), "placement")
+    identifier(placement["loop"], "loop reference")
+    if placement["fit"] not in ("cover", "contain"):
+        raise StateError("Only explicit cover/contain media fit is implemented")
+    rect, focal = placement["rect"], placement["focal"]
+    if not isinstance(rect, list) or len(rect) != 4:
+        raise StateError("rect must be normalized [x,y,width,height]")
+    x, y, w, h = [number(v, 0, 1, "rect") for v in rect]
+    if w <= 0 or h <= 0 or x + w > 1 + 1e-9 or y + h > 1 + 1e-9:
+        raise StateError("Rectangle is empty or outside the canvas")
+    if not isinstance(focal, list) or len(focal) != 2:
+        raise StateError("focal must be normalized [x,y]")
+    for v in focal:
+        number(v, 0, 1, "focal")
+
+
+def check_layout(layout: Any, ids: set[str]) -> None:
+    keys(layout, {"name", "placements"}, set(), "layout")
+    identifier(layout["name"], "layout name")
+    placements = layout["placements"]
+    if not isinstance(placements, list) or len(placements) != len(ids):
+        raise StateError("A layout must map every active loop exactly once")
+    for p in placements:
+        geometry(p)
+    if {p["loop"] for p in placements} != ids:
+        raise StateError("Duplicate, missing, or unknown layout loop")
+    # v1 rejects overlapping apertures, so no loop can be accidentally occluded.
+    for i, a in enumerate(placements):
+        ax, ay, aw, ah = a["rect"]
+        for b in placements[i + 1:]:
+            bx, by, bw, bh = b["rect"]
+            if min(ax + aw, bx + bw) - max(ax, bx) > 1e-9 and min(ay + ah, by + bh) - max(ay, by) > 1e-9:
+                raise StateError("Overlapping apertures are not supported in v1")
+
+
+def choose(seed: str, loop_id: str, counter: int, bank: list[str], previous: str | None = None) -> str:
+    """Counter-based SHA256 choice, independent of iteration order; modulo mapping."""
+    eligible = [sid for sid in bank if sid != previous] or bank
+    payload = json.dumps([RANDOMNESS, seed, loop_id, counter], separators=(",", ":"), ensure_ascii=False).encode()
+    return eligible[int.from_bytes(hashlib.sha256(payload).digest(), "big") % len(eligible)]
+
+
+def initial_runtime(state: dict[str, Any]) -> dict[str, Any]:
+    result = {}
+    for loop in state["loops"]:
+        source = loop["source"] if loop["source"] is not None else choose(state["seed"], loop["id"], loop["counter"], loop["bank"])
+        result[loop["id"]] = {**copy.deepcopy(loop), "source": source,
+                              "phase": fraction(loop["offset"], "offset"), "anchor": 0,
+                              "rate_fraction": fraction(loop["rate"], "rate")}
+    return result
+
+
+def span(loop: dict[str, Any]) -> Fraction:
+    return fraction(loop["trim"][1], "trim out") - fraction(loop["trim"][0], "trim in")
+
+
+def phase_at(loop: dict[str, Any], frame: int, fps: int) -> Fraction:
+    elapsed = Fraction(0) if loop["held"] else Fraction(frame - loop["anchor"], fps) * loop["rate_fraction"]
+    return (loop["phase"] + elapsed) % span(loop)
+
+
+def apply_event(runtime: dict[str, Any], layouts: dict[str, Any], event: dict[str, Any], state: dict[str, Any]) -> None:
+    f, kind = event["frame"], event["op"]
+    fps = state["fps"]
+    if kind == "swap":
+        a, b = (runtime[k] for k in event["loops"])
+        a["source"], b["source"] = b["source"], a["source"]
+        return
+    loop = runtime[event["loop"]]
+    if kind == "hold":
+        loop["phase"], loop["anchor"] = phase_at(loop, f, fps), f
+        loop["held"] = event["value"]
+    elif kind == "reroll":
+        loop["counter"] += 1
+        loop["source"] = choose(state["seed"], loop["id"], loop["counter"], loop["bank"], loop["source"])
+        loop["phase"], loop["anchor"] = Fraction(0), f
+    elif kind == "move":
+        for p in layouts[event["orientation"]]["placements"]:
+            if p["loop"] == loop["id"]:
+                p["rect"] = list(event["rect"])
+                break
+
+
+def compatible_sources(runtime: dict[str, Any], sources: dict[str, Any], reuse: bool) -> None:
+    active = [l["source"] for l in runtime.values()]
+    if not reuse and len(active) != len(set(active)):
+        raise StateError("Source reuse must be explicitly enabled; no automatic filler duplication")
+    for loop in runtime.values():
+        source = sources[loop["source"]]
+        end = fraction(loop["trim"][1], "trim end")
+        if end > fraction(source["duration"], "source duration"):
+            raise StateError(f"Trim exceeds selected/swapped source: {loop['id']}")
+
+
+def _validate(state: Any, media_root: Path | None = None) -> None:
+    keys(state, {"schema", "engine", "randomness", "id", "seed", "fps", "frames", "sources", "loops", "layouts", "events", "audio", "routing", "allow_source_reuse"}, {"note"}, "state")
+    if (state["schema"], state["engine"], state["randomness"]) != (SCHEMA, ENGINE, RANDOMNESS):
+        raise StateError("Unsupported schema, engine, or randomness version")
+    identifier(state["id"], "composition id")
+    if not isinstance(state["seed"], str) or not 1 <= len(state["seed"]) <= 200:
+        raise StateError("seed must be a nonempty string of at most 200 characters")
+    integer(state["fps"], 1, 120, "fps")
+    integer(state["frames"], 1, MAX_FRAMES, "frames")
+    if type(state["allow_source_reuse"]) is not bool:
+        raise StateError("allow_source_reuse must be boolean")
+    if state["audio"] != {"mode": "none", "generative": None} or state["routing"] != []:
+        raise StateError("Composition-v1 audio/routing is reserved, not implemented; use legacy CLI for existing audio modes")
+    if not isinstance(state["sources"], list) or not state["sources"]:
+        raise StateError("sources must be a nonempty ordered list")
+    sources = {}
+    for s in state["sources"]:
+        keys(s, {"id", "path", "sha256", "kind", "duration"}, set(), "source")
+        sid = identifier(s["id"], "source id")
+        if sid in sources:
+            raise StateError("Duplicate source identity")
+        if s["kind"] not in ("video", "still") or fraction(s["duration"], "duration") <= 0:
+            raise StateError("Source needs video/still kind and positive explicit duration")
+        if not isinstance(s["sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", s["sha256"]):
+            raise StateError("Source requires a SHA256 identity")
+        p = media_path(s, media_root or Path.cwd())
+        if s["kind"] == "still" and p.suffix.lower() not in (".png", ".jpg", ".jpeg", ".bmp", ".webp"):
+            raise StateError("Unsupported still extension")
+        if media_root is not None:
+            if not p.is_file():
+                raise StateError(f"Missing media: {s['id']}")
+            if hash_file(p) != s["sha256"]:
+                raise StateError(f"Media hash mismatch: {s['id']}")
+        sources[sid] = s
+    loops = state["loops"]
+    if not isinstance(loops, list) or not 1 <= len(loops) <= MAX_LOOPS:
+        raise StateError(f"v1 validation ceiling is {MAX_LOOPS} loops; only rendered counts are supported")
+    ids = set()
+    for loop in loops:
+        keys(loop, {"id", "bank", "source", "counter", "offset", "rate", "trim", "held"}, set(), "loop")
+        lid = identifier(loop["id"], "loop id")
+        if lid in ids:
+            raise StateError("Duplicate loop identity")
+        ids.add(lid)
+        bank = loop["bank"]
+        if not isinstance(bank, list) or not bank or any(not isinstance(k, str) or k not in sources for k in bank) or len(bank) != len(set(bank)):
+            raise StateError("Each loop needs an ordered unique bank of existing sources")
+        if loop["source"] is not None and loop["source"] not in bank:
+            raise StateError("Explicit initial source must belong to its bank")
+        integer(loop["counter"], 0, 10**9, "counter")
+        offset, rate = fraction(loop["offset"], "offset"), fraction(loop["rate"], "rate")
+        if not Fraction(1, 16) <= rate <= 16:
+            raise StateError("Only positive rates 1/16 through 16 are implemented")
+        if type(loop["held"]) is not bool:
+            raise StateError("held must be boolean")
+        if not isinstance(loop["trim"], list) or len(loop["trim"]) != 2:
+            raise StateError("trim must be [in-seconds rational, out-seconds rational]")
+        start, end = (fraction(v, "trim") for v in loop["trim"])
+        if end <= start or offset >= end - start:
+            raise StateError("Invalid trim or offset outside loop duration")
+        if any(end > fraction(sources[k]["duration"], "source duration") for k in bank):
+            raise StateError("Loop trim must fit every candidate in its bank")
+    keys(state["layouts"], set(ORIENTATIONS), set(), "paired layouts")
+    for layout in state["layouts"].values():
+        check_layout(layout, ids)
+    if not isinstance(state["events"], list) or len(state["events"]) > 1000:
+        raise StateError("events must be a list of at most 1000 items")
+    previous = -1
+    for e in state["events"]:
+        if not isinstance(e, dict) or e.get("op") not in ("hold", "reroll", "swap", "move"):
+            raise StateError("Unsupported event operation")
+        extra = {"hold": {"loop", "value"}, "reroll": {"loop"}, "swap": {"loops"}, "move": {"loop", "orientation", "rect"}}[e["op"]]
+        keys(e, {"frame", "op"} | extra, set(), "event")
+        f = integer(e["frame"], 0, state["frames"] - 1, "event frame")
+        if f < previous:
+            raise StateError("Events must be nondecreasing; array order breaks same-frame ties")
+        previous = f
+        if e["op"] == "swap":
+            if not isinstance(e["loops"], list) or len(e["loops"]) != 2 or len(set(e["loops"])) != 2 or not set(e["loops"]) <= ids:
+                raise StateError("swap requires two distinct known loops")
+        elif e["loop"] not in ids:
+            raise StateError("Event references unknown loop")
+        if e["op"] == "hold" and type(e["value"]) is not bool:
+            raise StateError("hold value must be boolean")
+        if e["op"] == "move":
+            if e["orientation"] not in ORIENTATIONS:
+                raise StateError("move requires explicit orientation")
+            geometry({"loop": e["loop"], "rect": e["rect"], "fit": "cover", "focal": [0.5, 0.5]})
+    runtime, layouts = initial_runtime(state), copy.deepcopy(state["layouts"])
+    compatible_sources(runtime, sources, state["allow_source_reuse"])
+    for e in state["events"]:
+        apply_event(runtime, layouts, e, state)
+        compatible_sources(runtime, sources, state["allow_source_reuse"])
+        for layout in layouts.values():
+            check_layout(layout, ids)
+
+
+def validate(state: Any, media_root: Path | None = None) -> None:
+    try:
+        _validate(state, media_root)
+    except (KeyError, TypeError, OverflowError) as exc:
+        raise StateError(f"Malformed state: {exc}") from exc
+
+
+def verify_media_streams(state: dict[str, Any], root: Path) -> None:
+    """Check encoded facts separately from hash/schema validation; no Adobe claim."""
+    for source in state["sources"]:
+        try:
+            p = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0",
+                                "-show_entries", "stream=width,height:format=duration", "-of", "json",
+                                str(media_path(source, root))], check=True, capture_output=True, text=True, timeout=30)
+            facts = json.loads(p.stdout)
+            stream = facts["streams"][0]
+            if stream["width"] <= 0 or stream["height"] <= 0:
+                raise ValueError("empty visual stream")
+            if source["kind"] == "video":
+                actual = float(facts["format"]["duration"])
+                declared = float(fraction(source["duration"], "duration"))
+                if not math.isfinite(actual) or actual + 0.001 < declared:
+                    raise ValueError("declared duration exceeds encoded media")
+        except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError) as exc:
+            raise StateError(f"Invalid visual source {source['id']}: {exc}") from exc
+
+
+def snapshot(state: dict[str, Any], frame: int) -> dict[str, Any]:
+    """Pure temporal replay; orientation deliberately absent from this signature."""
+    integer(frame, 0, state["frames"] - 1, "sample frame")
+    runtime, layouts = initial_runtime(state), copy.deepcopy(state["layouts"])
+    for event in state["events"]:
+        if event["frame"] > frame:
+            break
+        apply_event(runtime, layouts, event, state)
+    loops = {}
+    for lid, loop in runtime.items():
+        phase = phase_at(loop, frame, state["fps"])
+        time = phase + fraction(loop["trim"][0], "trim start")
+        loops[lid] = {"source": loop["source"], "phase": [phase.numerator, phase.denominator],
+                      "source_time": [time.numerator, time.denominator], "held": loop["held"],
+                      "counter": loop["counter"], "rate": loop["rate"], "trim": loop["trim"]}
+    return {"frame": frame, "loops": loops, "layouts": layouts}
+
+
+def orientation_for(width: int, height: int) -> str:
+    integer(width, 2, 8192, "viewport width")
+    integer(height, 2, 8192, "viewport height")
+    return "portrait" if height >= width else "landscape"
+
+
+def pixel_boxes(layout: dict[str, Any], width: int, height: int) -> dict[str, tuple[int, int, int, int]]:
+    """Even boundaries for YUV420. Shared edges round identically; no dropped loop."""
+    if width % 2 or height % 2:
+        raise StateError("Export dimensions must be even for YUV420")
+    integer(width, 2, 8192, "width")
+    integer(height, 2, 8192, "height")
+    boxes = {}
+    for p in layout["placements"]:
+        x, y, w, h = p["rect"]
+        x0, x1 = (round(v * width / 2) * 2 for v in (x, x + w))
+        y0, y1 = (round(v * height / 2) * 2 for v in (y, y + h))
+        if x1 <= x0 or y1 <= y0:
+            raise StateError("Viewport too small: would hide a panel")
+        boxes[p["loop"]] = (x0, y0, x1 - x0, y1 - y0)
+    return boxes
+
+
+def compile_segments(state: dict[str, Any], root: Path, orientation: str, width: int, height: int):
+    """Adapt state to the SAME Panel/Segment backend used by the legacy canon.
+
+    Scan a bounded frame timeline and coalesce linear spans. Splitting at loop
+    wraps, events, and layout changes prevents resetting unrelated clocks.
+    """
+    from render_triptych import Panel, Segment
+    validate(state, root)
+    if orientation not in ORIENTATIONS:
+        raise StateError("Explicit portrait/landscape export orientation required")
+    sources = {s["id"]: s for s in state["sources"]}
+    source_indexes = {sid: i for i, sid in enumerate(sources)}
+    fps = state["fps"]
+    chunks = []
+    first = previous = snapshot(state, 0)
+    start = 0
+    for f in range(1, state["frames"] + 1):
+        current = snapshot(state, f) if f < state["frames"] else None
+        continuous = current is not None and current["layouts"][orientation] == previous["layouts"][orientation]
+        if continuous:
+            for lid, old in previous["loops"].items():
+                new = current["loops"][lid]
+                step = Fraction(0) if old["held"] else fraction(old["rate"], "rate") / fps
+                if any(old[k] != new[k] for k in ("source", "held", "counter", "rate", "trim")) or fraction(new["source_time"], "time") != fraction(old["source_time"], "time") + step:
+                    continuous = False
+                    break
+        if not continuous:
+            layout = first["layouts"][orientation]
+            boxes = pixel_boxes(layout, width, height)
+            panels = []
+            for p in layout["placements"]:
+                loop = first["loops"][p["loop"]]
+                source = sources[loop["source"]]
+                panels.append(Panel(
+                    name=p["loop"], source_index=source_indexes[source["id"]], source_path=media_path(source, root),
+                    source_offset=float(fraction(loop["source_time"], "time")),
+                    source_duration=float(fraction(source["duration"], "duration")), source_has_audio=False,
+                    box=boxes[p["loop"]], source_kind=source["kind"], playback_rate=float(fraction(loop["rate"], "rate")),
+                    held=loop["held"], fit=p["fit"], focal=tuple(p["focal"]),
+                    trim_end=float(fraction(loop["trim"][1], "trim end")), clocked=True))
+            chunks.append(Segment(len(chunks), start / fps, (f - start) / fps, tuple(panels)))
+            start, first = f, current
+        previous = current
+    return chunks
+
+
+def render_cli(args: Any) -> int:
+    from render_triptych import Settings, SCRIPT_DIR, render, print_schedule, path_inside
+    state_path = args.composition.resolve()
+    state = load(state_path)
+    verify_media_streams(state, state_path.parent)
+    if args.manifest or args.input_dir:
+        raise StateError("Do not combine a legacy manifest/input with --composition")
+    # Reject ignored legacy options rather than implying support.
+    forbidden = ("timing", "phrase", "layout", "panel_order", "max_videos", "max_clip_seconds", "audio", "audio_panel", "audio_gain", "audio_left_gain", "audio_middle_gain", "audio_right_gain", "audio_fade", "direction", "tone", "tone_strength", "tone_smoothing")
+    if any(getattr(args, name) is not None for name in forbidden):
+        raise StateError("Legacy scheduling/audio/effect overrides are not composition-v1 capabilities")
+    if args.orientation not in ORIENTATIONS:
+        raise StateError("--composition requires --orientation portrait|landscape")
+    if args.fps is not None and args.fps != state["fps"]:
+        raise StateError("FPS is part of replay state; edit the state instead of overriding it")
+    default = (1080, 1920) if args.orientation == "portrait" else (1920, 1080)
+    width, height = args.width or default[0], args.height or default[1]
+    if orientation_for(width, height) != args.orientation:
+        raise StateError("Export dimensions contradict the requested orientation")
+    output = (args.output or (SCRIPT_DIR / "renders" / f"{state['id']}-{args.orientation}.mp4")).resolve()
+    work = (args.work_dir or SCRIPT_DIR / "work").resolve()
+    if not path_inside(output, SCRIPT_DIR) or not path_inside(work, SCRIPT_DIR):
+        raise StateError("Outputs/work must remain inside the incubator")
+    settings = Settings(input_dir=state_path.parent, output_file=output, work_dir=work,
+                        timing_mode="composition-v1", phrase_seconds=state["frames"] / state["fps"],
+                        width=width, height=height, fps=state["fps"], crf=args.crf if args.crf is not None else 20,
+                        preset=args.preset or "medium", max_videos=None, max_clip_seconds=None,
+                        dry_run=args.dry_run, keep_work=args.keep_work, layout="composition-v1", clip_paths=None,
+                        audio_mode="none", audio_panel="left", audio_gain=0.8, audio_panel_gains={},
+                        audio_fade_seconds=0, video_direction="forward", tone_mode="none", tone_strength=0.35,
+                        tone_smoothing=50, panel_order=("left", "middle", "right"), declarative=True)
+    segments = compile_segments(state, state_path.parent, args.orientation, width, height)
+    print_schedule(segments, settings)
+    if not args.dry_run:
+        render(segments, settings)
+        print(f"wrote {output}")
+    return 0
